# Database Configuration
# PostgreSQL (Production / Docker):
DATABASE_URL=postgresql+asyncpg://sentra:sentra_password@localhost:5432/sentra_db
# SQLite (Local zero-setup development):
# DATABASE_URL=sqlite+aiosqlite:///./sentra_dev.db

# Authentication & Security
SECRET_KEY=sentra-insecure-dev-secret-key-32-chars-minimum-length
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Gateway
AI_PROVIDER_DEFAULT=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
